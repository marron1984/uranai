{
  "$schema": "uranai-compat-rules-v1",
  "description": "yoshida-profile.json と任意の人物のプロファイルを使って相互相性を算出するためのルール集。各セクションが算出のレシピと参照テーブルを含む。",
  "version": "1.0.0",
  "generatedFrom": "https://github.com/marron1984/uranai",

  "howToUse": {
    "step1": "相手の生年月日・性別・氏名から、本ルールの formulas に従って 4 柱・九星・本命卦・数秘・MBTI(任意) を算出する",
    "step2": "yoshida-profile.json の compatKeys と相手の同等キーを下記 6 軸で比較する",
    "step3": "各軸のスコア (1-5) を重み付き平均して総合相性を出す"
  },

  "scoringAxes": [
    {
      "id": "shichu.dayMaster",
      "name": "日干同士の通変星",
      "weight": 1.0,
      "lookup": "tables.tongbianScore",
      "compute": "tongbianStar(yoshida.dayStem='丙', partner.dayStem) → score",
      "description": "ビジネス・恋愛・人間関係すべての基礎。丙 (日主) から見て相手がどの通変星に当たるかで関係性の質が決まる"
    },
    {
      "id": "shichu.yearBranch",
      "name": "年支の干支関係",
      "weight": 1.0,
      "lookup": "tables.branchInteraction",
      "compute": "yoshida.yearBranch='子' と partner.yearBranch の関係 (三合/六合/沖/害/刑/なし)",
      "description": "幼少期からの相性。世代・気質の根本的な調和度"
    },
    {
      "id": "kyusei.honmei",
      "name": "九星本命星の五行関係",
      "weight": 0.8,
      "lookup": "tables.kyuseiRelation",
      "compute": "starRelation(yoshida.honmei=7, partner.honmei) → score",
      "description": "対人運の核。性質的な相性"
    },
    {
      "id": "astrology.sun",
      "name": "太陽星座の関係",
      "weight": 0.6,
      "lookup": "tables.zodiacCompat",
      "compute": "yoshida.sunSign='taurus' と partner.sunSign のアスペクト (三分/対向/隣接/etc)",
      "description": "外面的な気質・第一印象の合致度"
    },
    {
      "id": "numerology.lifePath",
      "name": "ライフパス相性",
      "weight": 0.7,
      "lookup": "tables.lifePathCompat",
      "compute": "yoshida.lifePath=11 と partner.lifePath の組合せ",
      "description": "魂のレベルの相性。価値観の共鳴度"
    },
    {
      "id": "mbti",
      "name": "MBTI 認知機能の補完",
      "weight": 0.8,
      "lookup": "tables.mbtiCompat",
      "compute": "yoshida.mbti='INFJ' と partner.mbti を bestMatch/goodMatch/challenging で判定",
      "description": "思考と感情の処理パターン。深い対話の可能性"
    }
  ],

  "overallFormula": "overall = Σ(score_i × weight_i) / Σ(weight_i); 5段階に丸める",

  "tables": {
