    {
      "id": "astronomy.sunLongitude",
      "name": "太陽黄経 (Meeus 簡易版)",
      "file": "lib/astronomy.ts",
      "function": "sunLongitude(date)",
      "algorithm": "Meeus Astronomical Algorithms Ch.25。JD→T→L0,M,C→λ☉。精度 ~0.01°",
      "formula": [
        "JD = julianDay(date)",
        "T = (JD - 2451545.0) / 36525",
        "L0 = 280.46646 + 36000.76983*T + 0.0003032*T^2",
        "M = 357.52911 + 35999.05029*T - 0.0001537*T^2",
        "C = (1.914602 - 0.004817*T - 0.000014*T^2)*sin(M) + (0.019993 - 0.000101*T)*sin(2M) + 0.000289*sin(3M)",
        "λ = (L0 + C) mod 360"
      ],
      "output": "number (degrees 0-360)"
    },
    {
      "id": "astronomy.moonLongitude",
      "name": "月黄経 (ELP2000 簡易版)",
      "file": "lib/astronomy.ts",
